# Copy to backend/.env and chmod 600. Never commit .env.
# Existing shell environment variables always win over this file.

# demo | real
DEVCOM_MODE=demo

# openai | fake  (real mode typically openai)
DEVCOM_LLM_ADAPTER=fake

# fake | real  — in DEVCOM_MODE=real must be real; Fake never substitutes silently
DEVCOM_CURSOR_ADAPTER=fake

DEVCOM_HOST=127.0.0.1
DEVCOM_PORT=8765
# DEVCOM_DATA_DIR=/home/you/.local/share/devcom/demo

# Secrets — leave empty in example; fill only in local .env
OPENAI_API_KEY=
CURSOR_API_KEY=
