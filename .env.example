# Fictitious local demo settings — copy values locally if needed; do not commit secrets.
DEVCOM_MODE=demo
# DEVCOM_MODE=real
DEVCOM_HOST=127.0.0.1
DEVCOM_PORT=8765
# Optional override (default: ~/.local/share/devcom/demo)
# DEVCOM_DATA_DIR=/home/you/.local/share/devcom/demo
DEVCOM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DEVCOM_ALLOWED_HOSTS=127.0.0.1:8765,localhost:8765
# DEVCOM_LLM_ADAPTER=openai
# DEVCOM_LLM_ADAPTER=fake
# OPENAI_API_KEY is read from the process environment (not DEVCOM_*) — never commit it.
# OPENAI_API_KEY=
